#!/bin/sh
# DEBIAN/postinst script for social-media-downloader
set -e

case "$1" in
    configure)
        echo "=========================================================="
        echo " Installing latest Social Media Downloader engine from GitHub..."
        echo "=========================================================="
        # Download yt-dlp to /usr/local/bin/
        if wget -q -O /usr/local/bin/yt-dlp "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp"; then
            chmod a+rx /usr/local/bin/yt-dlp
            echo " Downloader engine installed successfully."
        else
            echo " [Error] Failed to download downloader engine. Attempting curl fallback..."
            if curl -L -s -o /usr/local/bin/yt-dlp "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp"; then
                chmod a+rx /usr/local/bin/yt-dlp
                echo " Downloader engine installed successfully via curl."
            else
                echo " [Error] Installation failed. Please check your internet connection."
                exit 1
            fi
        fi
        echo "=========================================================="
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
